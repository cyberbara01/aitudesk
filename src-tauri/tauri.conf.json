{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AITU Desk",
  "version": "1.0.0",
  "identifier": "kz.edu.astanait.aitudesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "clock",
        "title": "AITU Desk: часы",
        "url": "index.html",
        "width": 280,
        "height": 120,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "closable": false,
        "visible": true,
        "focus": false,
        "x": -32000,
        "y": -32000,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --process-per-site",
        "scrollBarStyle": "fluentOverlay"
      },
      {
        "label": "system",
        "title": "AITU Desk: система",
        "url": "index.html",
        "width": 280,
        "height": 144,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "closable": false,
        "visible": true,
        "focus": false,
        "x": -32000,
        "y": -32000,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --process-per-site",
        "scrollBarStyle": "fluentOverlay"
      },
      {
        "label": "launchers",
        "title": "AITU Desk: ярлыки",
        "url": "index.html",
        "width": 280,
        "height": 184,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "closable": false,
        "visible": true,
        "focus": false,
        "x": -32000,
        "y": -32000,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --process-per-site",
        "scrollBarStyle": "fluentOverlay"
      },
      {
        "label": "map",
        "title": "AITU Desk: карта",
        "url": "index.html",
        "width": 640,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "closable": false,
        "visible": true,
        "focus": false,
        "x": -32000,
        "y": -32000,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --process-per-site",
        "scrollBarStyle": "fluentOverlay"
      },
      {
        "label": "schedule",
        "title": "AITU Desk: расписание",
        "url": "index.html",
        "width": 280,
        "height": 256,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "closable": false,
        "visible": true,
        "focus": false,
        "x": -32000,
        "y": -32000,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --process-per-site",
        "scrollBarStyle": "fluentOverlay"
      },
      {
        "label": "notes",
        "title": "AITU Desk: заметки",
        "url": "index.html",
        "width": 280,
        "height": 200,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "closable": false,
        "visible": true,
        "focus": false,
        "x": -32000,
        "y": -32000,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --process-per-site",
        "scrollBarStyle": "fluentOverlay"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false
      }
    },
    "publisher": "AITU Desk",
    "shortDescription": "Виджеты рабочего стола для студентов Astana IT University",
    "copyright": "© 2026 cyberbara01. Карта AITU: aitumap (Yuujiso, MIT). Иконки: Fluent UI System Icons (Microsoft, MIT)"
  }
}
